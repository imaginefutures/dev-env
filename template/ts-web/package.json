{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:boundaries": "depcruise src web --config .dependency-cruiser.cjs",
    "knip": "knip",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "scripts/heavy/vitest.sh",
    "test:fast": "vitest run --project unit",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm format && pnpm knip && pnpm test",
    "prepare": "if [ -d .git ]; then lefthook install; fi"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "18.7.0",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
